{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vpn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6429e8ac-a903-4f82-9b24-b13ff8017a22","database_name": "vpn" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "651f5acb54aa4b82a9b24188b322a833" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
